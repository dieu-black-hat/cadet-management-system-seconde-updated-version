# Copy this file to .env and adjust. Never commit .env.
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_DEBUG=true
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# PostgreSQL connection
DATABASE_URL=postgres://cadet_user:change-me@localhost:5432/cadet_management

# Security tuning
SESSION_IDLE_TIMEOUT_SECONDS=1800
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_RESET_TIMEOUT=3600
MAX_UPLOAD_SIZE_MB=5

# Confidential file storage (outside any public folder)
PRIVATE_MEDIA_ROOT=

# E-mail: console backend prints e-mails in the terminal during development
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=OCMS <no-reply@example.org>

INSTITUTION_NAME=Officer Cadet Training Academy
SYNTHETIC_DATA_BANNER=true
TIME_ZONE=Africa/Kigali
